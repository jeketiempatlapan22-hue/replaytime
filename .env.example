# ============================================================
# ReplayTime (RealTime48) — Daftar Environment Variable
# ============================================================
# File ini adalah CONTOH. Jangan isi nilai rahasia di sini lalu
# di-commit ke GitHub. Untuk deploy ke Vercel, salin nilai asli
# dari file .env lokal ke: Vercel Dashboard → Project →
# Settings → Environment Variables.
# ============================================================

# ------------------------------------------------------------
# FRONTEND (wajib diisi di Vercel)
# Variabel berawalan VITE_ dibaca saat build oleh Vite.
# Nilainya PUBLIK (aman tampil di browser) — salin apa adanya
# dari file .env proyek ini.
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
VITE_SUPABASE_PROJECT_ID=xxxxxxxx

# ------------------------------------------------------------
# BACKEND / EDGE FUNCTIONS (TIDAK perlu diisi di Vercel)
# Variabel di bawah hanya dipakai fungsi server di Lovable
# Cloud dan tetap tersimpan di sana. Daftar ini hanya sebagai
# dokumentasi agar tidak lupa saat migrasi backend.
# ------------------------------------------------------------
# SUPABASE_URL=...                  (otomatis dari Lovable Cloud)
# SUPABASE_ANON_KEY=...             (otomatis dari Lovable Cloud)
# SUPABASE_SERVICE_ROLE_KEY=...     (otomatis, RAHASIA — jangan pernah taruh di frontend)
# LOVABLE_API_KEY=...               (otomatis dari Lovable Cloud)

# Pembayaran Pakasir (QRIS)
# PAKASIR_API_KEY=...
# PAKASIR_PROJECT_SLUG=...

# WhatsApp (Fonnte)
# FONNTE_TOKEN=...
# FONNTE_WEBHOOK_SECRET=...

# Telegram Bot
# TELEGRAM_API_KEY=...

# Streaming IDN / Hanabira
# HANABIRA_PARTNER_SECRET=...
# STREAM_GRANT_SECRET=...

# Tugas terjadwal (cron)
# CRON_KEY=...
